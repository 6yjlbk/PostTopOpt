if(NOT DEFINED TEST_EXE OR NOT DEFINED OUTPUT_ROOT)
    message(FATAL_ERROR "TEST_EXE and OUTPUT_ROOT are required")
endif()
string(TIMESTAMP stamp "%Y%m%d-%H%M%S")
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef suffix)
set(output "${OUTPUT_ROOT}/shape-results-${stamp}-${suffix}")
get_filename_component(exe_dir "${TEST_EXE}" DIRECTORY)
# The caller supplies PATH for its own compatible ParaView SDK.
if(WIN32)
    set(ENV{PATH} "${exe_dir};$ENV{PATH}")
endif()
message(STATUS "Shape results: ${output}")
execute_process(COMMAND "${TEST_EXE}" "${output}" RESULT_VARIABLE status)
if(NOT "${status}" STREQUAL "0")
    message(FATAL_ERROR "VFTransferShapes failed: ${status}. Results: ${output}")
endif()
